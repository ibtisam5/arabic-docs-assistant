ANTHROPIC_API_KEY=

# Optional: Upstash Redis for rate limits shared across serverless instances.
# Without these, limits are kept in memory (fine for local development).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: tune the limits
RATE_LIMIT_QUESTIONS_PER_VISITOR=10
RATE_LIMIT_UPLOADS_PER_VISITOR=10
RATE_LIMIT_QUESTIONS_PER_DAY=100
